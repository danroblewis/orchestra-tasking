#!/usr/bin/env bash
# Orchestra watching this repository: its host and web UI. Runs with Orchestra's own environment
# (ORCHESTRA_HOME, default ~/orchestra_2).
#   bin/orchestra-ctl start | stop | status | restart <name>
set -euo pipefail
cd "$(dirname "$0")/.."
RUN=run; mkdir -p "$RUN"
HOME_O="${ORCHESTRA_HOME:-$HOME/orchestra_2}"; PY="$HOME_O/.venv/bin/python"; PORT="${PORT:-8060}"
NAMES="host web"
start() {
  local name=$1; shift
  if [ -f "$RUN/$name.pid" ] && kill -0 "$(cat "$RUN/$name.pid")" 2>/dev/null; then echo "$name: already running"; return; fi
  nohup "$@" >> "$RUN/$name.log" 2>&1 &
  echo $! > "$RUN/$name.pid"; echo "$name: started (pid $!)"
}
stop() { local n=$1; if [ -f "$RUN/$n.pid" ]; then kill "$(cat "$RUN/$n.pid")" 2>/dev/null || true; rm -f "$RUN/$n.pid"; echo "$n: stopped"; fi; }
one() { case $1 in host) start host "$PY" -m orchestra run ;; web) start web "$PY" -m orchestra web --port "$PORT" ;; esac; }
case "${1:-status}" in
  start) for n in $NAMES; do one "$n"; done; echo "web: http://127.0.0.1:$PORT" ;;
  stop) for n in web host; do stop "$n"; done ;;
  restart) n="${2:?which: $NAMES}"; stop "$n"; one "$n" ;;
  status) for n in $NAMES; do if [ -f "$RUN/$n.pid" ] && kill -0 "$(cat "$RUN/$n.pid")" 2>/dev/null; then echo "$n: running"; else echo "$n: stopped"; fi; done ;;
  *) echo "usage: $0 start | stop | status | restart <name>"; exit 2 ;;
esac
